---
interface Props { pageTitle?: string; }
const { pageTitle } = Astro.props;
---
<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label="Circuits and Systems Classroom home">
      <img src="/adc-toolbox-logo.svg?v=20260918" width="24" height="24" alt="" aria-hidden="true" />
      <span class="brand-name">Circuits &amp; Systems Classroom</span>
    </a>
    {pageTitle ? <h1 class="course-title">{pageTitle}</h1> : <span class="course-title" aria-hidden="true"></span>}
    <div class="right">
      <nav aria-label="Reference navigation">
        <a class="github" href="https://github.com/Arcadia-1/circuits-and-systems-classroom" aria-label="Circuits &amp; Systems Classroom on GitHub">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.69-4.57 4.94.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
          <span>GitHub <span aria-hidden="true">↗</span></span>
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid var(--rule-soft); background: color-mix(in srgb, var(--ground) 88%, transparent); backdrop-filter: blur(14px); }
  .bar { width: 100%; height: 48px; padding-inline: 24px; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; column-gap: 20px; }
  a { text-decoration: none; }
  .brand { min-width: 0; justify-self: start; display: flex; align-items: center; gap: 9px; font-size: 13px; font-weight: 600; letter-spacing: -0.02em; white-space: nowrap; }
  .brand img { display: block; flex: none; }
  .brand-name { overflow: hidden; text-overflow: ellipsis; }
  .course-title { min-width: 0; max-width: min(48vw, 680px); margin: 0; overflow: hidden; text-overflow: ellipsis; color: var(--ink); font-size: 14px; line-height: 1.2; font-weight: 550; letter-spacing: -0.015em; text-align: center; white-space: nowrap; }
  .right { min-width: 0; justify-self: end; display: flex; align-items: center; gap: 10px; }
  nav { display: flex; align-items: center; gap: 24px; font-size: 13px; color: var(--ink-2); }
  nav a { display: flex; align-items: center; gap: 7px; min-height: 40px; }
  nav a:hover { color: var(--ink); }
  .github { color: var(--ink); }
  .github span span { color: var(--ink-2); }
  @media (max-width: 1100px) {
    .bar { column-gap: 12px; }
    .brand-name { display: none; }
    .course-title { max-width: 54vw; }
  }
  @media (max-width: 600px) {
    .bar { padding-inline: 16px; column-gap: 8px; }
    .brand { gap: 0; }
    .course-title { max-width: 52vw; font-size: 12.5px; }
    .right { gap: 3px; }
    nav { gap: 12px; font-size: 12px; }
    .github span { display: none; }
  }
</style>
