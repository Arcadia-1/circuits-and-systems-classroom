---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Theme from '../components/Theme.astro';
import { isLessonPath, isPublicLessonPath } from '../data/publication';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Disable analytics for pages that should not record a visit. */
  visits?: boolean;
}
const { title, description, visits = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const holdFromIndex = isLessonPath(Astro.url.pathname) && !isPublicLessonPath(Astro.url.pathname);
const siteName = 'Circuits & Systems Classroom';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteName ? `${title} · Interactive lessons` : `${title} · ${siteName}`}</title>
    <meta name="description" content={description} />
    {holdFromIndex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/adc-toolbox-logo.svg?v=20260918" type="image/svg+xml" />
    <link rel="shortcut icon" href="/adc-toolbox-logo.svg?v=20260918" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f6f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0d13" media="(prefers-color-scheme: dark)" />
    <ClientRouter />
    <Theme />
  </head>
  <body transition:animate="none">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader pageTitle={isLessonPath(Astro.url.pathname) ? title : undefined} />
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <SiteFooter {visits} />
  </body>
</html>
