---
import '@fontsource-variable/google-sans-code';
import AnalyticsPage from '../../analytics/AnalyticsPage';
import Theme from '../components/Theme.astro';
import { ClientRouter } from 'astro:transitions';
---
<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <title>Site Analytics · Circuits &amp; Systems Classroom</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href="/adc-toolbox-logo.svg?v=20260918" type="image/svg+xml" />
    <link rel="shortcut icon" href="/adc-toolbox-logo.svg?v=20260918" />
    <ClientRouter />
    <Theme />
  </head>
  <body transition:animate="none">
    <AnalyticsPage client:only="react" />
  </body>
</html>

<style is:global>
  /* What the module gets from its host in analog-arena: the mono font token and Tailwind's preflight. */
  :root { color-scheme: light; --font-mono: "Google Sans Code Variable", "Google Sans Code", ui-monospace, "SF Mono", monospace; }
  *, ::before, ::after { box-sizing: border-box; margin: 0; padding: 0; border: 0 solid; }
  html { line-height: 1.5; -webkit-text-size-adjust: 100%; }
  h1, h2 { font-size: inherit; font-weight: inherit; }
  a { color: inherit; text-decoration: inherit; }
  code { font-family: var(--font-mono); font-size: 1em; }
  table { border-collapse: collapse; }
  ul { list-style: none; }
  svg { display: block; vertical-align: middle; }
  button, input { font: inherit; color: inherit; border-radius: 0; background-color: transparent; }
  ::-webkit-date-and-time-value { min-height: 1lh; text-align: inherit; }
  ::-webkit-datetime-edit { display: inline-flex; }
  ::-webkit-datetime-edit-fields-wrapper { padding: 0; }
  ::-webkit-datetime-edit, ::-webkit-datetime-edit-year-field, ::-webkit-datetime-edit-month-field, ::-webkit-datetime-edit-day-field { padding-block: 0; }
</style>
