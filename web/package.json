{
  "name": "circuits-and-systems-classroom",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "browser:check": "pnpm build && pnpm test:browser",
    "test:browser:report": "playwright show-report",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && wrangler types --config worker/wrangler.jsonc --include-env=false worker/worker-configuration.d.ts > /dev/null && tsc -p worker && vitest run",
    "deploy:analytics": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/google-sans-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/stix-two-text": "^5.3.0",
    "astro": "^7.3.2",
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
